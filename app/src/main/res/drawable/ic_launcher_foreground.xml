<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive layers span 108dp; the launcher mask spans the central 72dp.
     Fit the full-bleed artwork to that visible square, with blue behind it. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16.666667%" android:insetTop="16.666667%"
    android:insetRight="16.666667%" android:insetBottom="16.666667%">
    <bitmap android:src="@drawable/ic_launcher_artwork" android:gravity="fill" android:filter="true" />
</inset>
